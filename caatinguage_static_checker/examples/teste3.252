program TesteTokens

declarations
    integer a, b, c;
    real r1, r2;
    string s1, s2;
    boolean flag;
    character ch;
enddeclarations

functions

function integer soma(integer x, integer y)
{
    integer resultado;
    resultado := x + y;
    return resultado;
}
endfunction


function void main()
{
    a := 10;
    b := 20;
    c := 0;

    r1 := 1.5;
    r2 := 2.75;

    s1 := "abc";
    s2 := "def";

    flag := true;
    ch := 'Z';

    if (a < b) and (r1 <= r2)  // 'and' vai ser IDENT (não é palavra reservada)
    then
        c := soma(a, b);
        print c;
    else
        print "nao entrou no if";
    endif

    while c > 0
    do
        print c;
        c := c - 1;
        if c == 5
        then
            break;
        endif
    endwhile

    // operadores variados
    a := a - 1;
    b := b * 2;
    r1 := r1 / 3.0;
    r2 := r2 % 2.0;  // se o professor não usar % para real, ainda assim é léxico válido

    // comparação com != e #
    if a != b
    then
        print "a diferente de b";
    endif

    if a # c
    then
        print "a diferente de c (usando #)";
    endif

    return;
}
endfunction

endfunctions

endprogram
